# HIP-4 Desk Environment Configuration

# Network environment: "testnet" | "mainnet"
# IMPORTANT: Mainnet is strictly read-only. Order execution is NEVER allowed on mainnet!
HIP4_NETWORK=testnet

# Hyperliquid API Base URLs
HYPERLIQUID_MAINNET_API_URL=https://api.hyperliquid.xyz
HYPERLIQUID_TESTNET_API_URL=https://api.hyperliquid-testnet.xyz

# Testnet Wallet Configuration (Optional for dry-run, required for live testnet quoting)
# NEVER put mainnet private keys here!
HIP4_TESTNET_PRIVATE_KEY=
HIP4_TESTNET_WALLET_ADDRESS=

# Quoting Engine Parameters
DEFAULT_BASE_SPREAD=0.03          # 3 cents base spread (e.g., 0.03 = 3%)
DEFAULT_ORDER_SIZE=15             # USD notional per quote order (minimum 10 USDH)
DEFAULT_MAX_INVENTORY=200         # Max net position contracts per outcome
DEFAULT_EXPIRY_PULLBACK_MINUTES=30# Pull quotes 30 mins before expiry (anti-gamma risk)
DEFAULT_ANNUAL_VOLATILITY=0.60    # 60% default annualized vol fallback
TICK_INTERVAL_MS=5000             # 5 seconds per quoting loop tick

# Target Market / Venue filters
TARGET_VENUE=                     # e.g., "ae", "out", or leave empty to quote detected priceBinary markets
TARGET_OUTCOME_ID=                # Specify a single outcome ID to quote, or leave empty
